    "fields": [
      {
        "name": "reg_hclk_en",
        "lsb": 2,
        "width": 1,
        "access": "RW",
        "description": "MCU high-speed bus clock gate."
      },
      {
        "name": "reg_bclk_en",
        "lsb": 3,
        "width": 1,
        "access": "RW",
        "description": "MCU peripheral bus clock gate."
      },
      {
        "name": "reg_hclk_div",
        "lsb": 8,
        "width": 8,
        "access": "RW",
        "description": "MCU core/high-speed clock divisor minus one."
      },
      {
        "name": "reg_bclk_div",
        "lsb": 16,
        "width": 8,
        "access": "RW",
        "description": "MCU bus clock divisor minus one."
      }
    ]
  },
  "glb-sdh": {
    "name": "SDH_CFG0",
    "base": "0x20000000",
    "offset": "0x430",
    "width": 32,
    "summary": "SDH module clock selection, divider and enable.",
    "fields": [
      {
        "name": "reg_sdh_clk_div",
        "lsb": 9,
        "width": 3,
        "access": "RW",
        "description": "SDH module clock divisor minus one."
      },
      {
        "name": "reg_sdh_clk_sel",
        "lsb": 12,
        "width": 1,
        "access": "RW",
        "description": "0 selects the WIFIPLL divide-by-five branch; 1 selects the CPUPLL SDH branch."
      },
      {
        "name": "reg_sdh_clk_en",
        "lsb": 13,
        "width": 1,
        "access": "RW",
        "description": "SDH module clock enable. The bus gate is controlled separately."
      }
    ]
  },
  "glb-gates": {
    "name": "CGEN_CFG2",
    "base": "0x20000000",
    "offset": "0x588",
    "width": 32,
    "summary": "Peripheral bus clock gates; the SDH field is shown here.",
    "fields": [
      {
        "name": "cgen_s1_ext_sdh",
        "lsb": 22,
        "width": 1,
        "access": "RW",
        "description": "SDH bus clock enable. This gate is separate from SDH_CFG0 module-clock enable."
      }
    ]
  },
  "hbn-glb": {
    "name": "HBN_GLB",
    "base": "0x2000f000",
    "offset": "0x30",
    "width": 32,
    "summary": "Root and UART clock selectors in the always-on clock domain.",
    "fields": [
      {
        "name": "hbn_root_clk_sel",
        "lsb": 0,
        "width": 2,
        "access": "RW",
        "description": "Bit 0 selects XCLK: 0 RC32M, 1 XTAL. Bit 1 selects the MCU root: 0 XCLK, 1 PDS PLL branch."
      },
      {
        "name": "hbn_uart_clk_sel",
        "lsb": 2,
        "width": 1,
        "access": "RW",
        "description": "Selects the first UART clock mux: 0 BCLK, 1 the MCU mux-PLL branch."
      },
      {
        "name": "hbn_uart_clk_sel2",
        "lsb": 15,
        "width": 1,
        "access": "RW",
        "description": "Selects the UART parent: 0 first UART mux, 1 XCLK."
      }
    ]
  },
  "pds-cpu": {
    "name": "CPU_CORE_CFG1",
    "base": "0x2000e000",
    "offset": "0x114",
    "width": 32,
    "summary": "PDS PLL selection and MCU clock gate.",
    "fields": [
      {
        "name": "reg_pll_sel",
        "lsb": 4,
        "width": 2,
        "access": "RW",
        "description": "PDS PLL parent selector: 0 CPUPLL branch, 1 AUPLL divide-by-one, 2 WIFIPLL 240M branch, 3 WIFIPLL 320M branch. Branch names identify selector options rather than measured rates."
      },
      {
        "name": "reg_mcu1_clk_en",
        "lsb": 8,
        "width": 1,
        "access": "RW",
        "description": "MCU clock enable associated with the PDS PLL path."
      }
    ]
  },
  "mm-control": {
    "name": "MM_CLK_CTRL_CPU",
    "base": "0x30007000",
    "offset": "0x0",
    "width": 32,
    "summary": "MM clock-source selectors, D0 gate and divider handshake.",
    "fields": [
      {
        "name": "reg_uart_clk_sel",
        "lsb": 4,
        "width": 2,
        "access": "RW",
        "description": "UART parent selector: 0 MM_BCLK1X, 1 MM_MUXPLL_160M, 2 MM_XCLK."
      },
      {
        "name": "reg_cpu_clk_sel",
        "lsb": 8,
        "width": 2,
        "access": "RW",
        "description": "PLL-path selector: 0 MM_MUXPLL_240M, 1 MM_MUXPLL_320M, 2 or 3 CPUPLL_400M. Branch names are hardware/software identifiers."
      },
      {
        "name": "reg_xclk_clk_sel",
        "lsb": 10,
        "width": 1,
        "access": "RW",
        "description": "MM_XCLK source: 0 RC32M, 1 XTAL."
      },
      {
        "name": "reg_cpu_root_clk_sel",
        "lsb": 11,
        "width": 1,
        "access": "RW",
        "description": "D0 root source: 0 MM_XCLK, 1 the PLL-path mux."
      },
      {
        "name": "reg_mmcpu0_clk_en",
        "lsb": 12,
        "width": 1,
        "access": "RW",
        "description": "D0/C906 core clock gate."
      },
      {
        "name": "reg_bclk1x_sel",
        "lsb": 13,
        "width": 2,
        "access": "RW",
        "description": "MM_BCLK1X parent: 0 or 1 MM_XCLK, 2 MM_MUXPLL_160M, 3 MM_MUXPLL_240M."
      },
      {
        "name": "reg_bclk2x_div_act_pulse",
        "lsb": 18,
        "width": 1,
        "access": "W1P",
        "description": "Write one to request application of the BCLK2X divider setting."
      },
      {
        "name": "sts_bclk2x_prot_done",
        "lsb": 20,
        "width": 1,
        "access": "RO",
        "description": "Divider-change handshake completion status."
      }
    ]
  },
