{
  "cpu-rtc": {
    "name": "CPU_RTC",
    "base": "0x30000000",
    "offset": "0x18",
    "width": 32,
    "summary": "C906 time-counter divider, clock enable and reset control.",
    "fields": [
      {
        "name": "c906_rtc_div",
        "lsb": 0,
        "width": 10,
        "access": "RW",
        "description": "Counter clock divisor minus one. Counter rate = D0 core rate / (field value + 1)."
      },
      {
        "name": "c906_rtc_rst",
        "lsb": 30,
        "width": 1,
        "access": "RW",
        "description": "Counter reset control. Assert and then clear this bit to release reset."
      },
      {
        "name": "c906_rtc_en",
        "lsb": 31,
        "width": 1,
        "access": "RW",
        "description": "Set to enable the counter clock; clear to stop the counter clock."
      }
    ]
  },
  "glb-system": {
    "name": "SYS_CFG0",
    "base": "0x20000000",
    "offset": "0x90",
    "width": 32,
